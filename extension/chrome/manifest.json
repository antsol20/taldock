{
  "manifest_version": 3,
  "name": "taldock tab bridge",
  "version": "1.0.0",
  "description": "Reports open tabs to the taldock dock so it can stack them under the browser icon.",
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "nativeMessaging"],
  "host_permissions": ["<all_urls>"]
}
